/* SPDX-License-Identifier: GPL-2.0+ */
/*
 * Ubuntu Core boot of Qualcomm boards booting from UFS.
 *
 * The partition numbers are the ones of the gadget, which lays out LUN 0, which
 * U-Boot sees as SCSI device 0, the same way as the i.MX gadget does its disk.
 */

stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
fastboot=fastboot -l $fastboot_addr_r usb 0

console=ttyMSM0,115200n8
devtype=scsi
devnum=0
seed_part=4
system_part_a=5
system_part_b=6
apps_part_a=7
apps_part_b=8
/* What LUN 0 is to the kernel */
disk=sda

loadfiles=sqfsload ${devtype} ${devnum}:${os_part}:1 ${loadaddr} ${kernel_filename}
kernel_filename=kernel.img
snapd_recovery_mode=install

/*
 * Boot the system slot through the initrd in the FIT image. The initrd finds the
 * base snap in the nested GPT of the slot partition and maps it with the
 * dm-verity root hash the slot's own metadata partition carries, so all the env
 * passes is which slot: 'uc_slot' plus the partitions of both slots, which
 * userspace needs as well.
 *
 * 'try_mode' is the A/B handshake: 'try' boots 'try_slot' once and moves to
 * 'trying', a boot which finds it still at 'trying' means the trial never got to
 * mark itself successful, so it is dropped and 'active_slot' boots. A slot which
 * is neither 'a' nor 'b' falls back to 'a', and the cmdline names the slot which
 * actually boots, so the initrd and userspace agree with what U-Boot loaded.
 */
load_uc_mini=
	slot="${active_slot}";
	if test "${try_mode}" = "try"; then
		if test "${try_slot}" = "a" || test "${try_slot}" = "b"; then
			echo "Booting slot ${try_slot} in try mode";
			setenv try_mode "trying"; saveenv;
			slot="${try_slot}";
		else
			echo "try mode is armed without a valid try slot, ignoring it";
			setenv try_mode ""; setenv try_slot ""; saveenv;
		fi;
	elif test "${try_mode}" = "trying"; then
		echo "try boot of slot ${try_slot} did not complete, booting slot ${active_slot}";
		setenv try_mode ""; setenv try_slot ""; saveenv;
	fi;
	if test "${slot}" = "b"; then
		os_part="${system_part_b}";
	else
		if test "${slot}" != "a"; then
			echo "boot env names no valid slot [${slot}], booting slot a";
			slot="a";
		fi;
		os_part="${system_part_a}";
	fi;
	setenv bootargs "console=${console} snapd_recovery_mode=${snapd_recovery_mode} uc_slot=${slot} system_a=${disk}${system_part_a} system_b=${disk}${system_part_b} apps_a=${disk}${apps_part_a} apps_b=${disk}${apps_part_b}";
	run loadfiles

boot_uc=run load_uc_mini;bootm ${loadaddr}#${fit_config}
