mfgtool_args=setenv bootargs console=${console},${baudrate} rdinit=/linuxrc clk_ignore_unused

#ifdef CONFIG_USB_PORT_AUTO
fb_cmd=fastboot auto
#else
fb_cmd=fastboot 0
#endif

#if defined(CONFIG_IMX8MM) || defined(CONFIG_IMX8MQ) || defined(CONFIG_IMX8QM) || \
    defined(CONFIG_IMX8QXP) || defined(CONFIG_IMX8DXL) || defined(CONFIG_IMX8MN) || \
    defined(CONFIG_IMX8MP)
nandfit_part=yes
#endif

bootcmd_mfg=run mfgtool_args;
	if iminfo ${initrd_addr}; then
		if test ${tee} = yes; then
			bootm ${tee_addr} ${initrd_addr} ${fdt_addr};
		else
			${kboot} ${loadaddr} ${initrd_addr} ${fdt_addr};
		fi;
	else
		echo Run fastboot ...; ${fb_cmd};
	fi;

loadfiles=sqfsload ${devtype} ${mmcdev}:${os_part}:1 ${fitloadaddr} ${kernel_filename}
kernel_filename=kernel.img
snapd_recovery_mode=install

/*
 * Boot the system slot through the initrd in the FIT image. The initrd finds the
 * base snap in the nested GPT of the slot partition and maps it with the
 * dm-verity root hash the slot's own metadata partition carries, so all the env
 * passes is which slot: 'uc_slot' plus the partitions of both slots, which
 * userspace needs as well.
 *
 * 'slot_status' is the A/B handshake snapd arms and commits: 'try' boots
 * 'try_slot' once and moves to 'trying', a boot which finds it still at 'trying'
 * means the trial never got to be marked successful, so its status is dropped and
 * 'active_slot' boots. 'try_slot' is left for snapd, which sees a trial without a
 * status as a failed one and clears it. A slot which is neither 'a' nor 'b' falls
 * back to 'a', and the cmdline names the slot which actually boots, so the initrd
 * and userspace agree with what U-Boot loaded.
 */
load_uc_mini=
	slot="${active_slot}";
	if test "${slot_status}" = "try"; then
		if test "${try_slot}" = "a" || test "${try_slot}" = "b"; then
			echo "Booting slot ${try_slot} in try mode";
			setenv slot_status "trying"; saveenv;
			slot="${try_slot}";
		else
			echo "a trial is armed without a valid try slot, ignoring it";
			setenv slot_status ""; setenv try_slot ""; saveenv;
		fi;
	elif test "${slot_status}" = "trying"; then
		echo "try boot of slot ${try_slot} did not complete, booting slot ${active_slot}";
		setenv slot_status ""; saveenv;
	fi;
	if test "${slot}" = "b"; then
		os_part="${mmc_system_part_b}";
	else
		if test "${slot}" != "a"; then
			echo "boot env names no valid slot [${slot}], booting slot a";
			slot="a";
		fi;
		os_part="${mmc_system_part_a}";
	fi;
	setenv bootargs "console=${console} snapd_recovery_mode=${snapd_recovery_mode} uc_slot=${slot} ${snapd_standard_params}
		system_a=mmcblk${mmcdev}p${mmc_system_part_a} system_b=mmcblk${mmcdev}p${mmc_system_part_b} apps_a=mmcblk${mmcdev}p${mmc_apps_part_a} apps_b=mmcblk${mmcdev}p${mmc_apps_part_b}
		${snapd_standard_params}";
	run loadfiles
