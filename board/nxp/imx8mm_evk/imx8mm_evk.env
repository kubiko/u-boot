#include <env/nxp/imx_env.env>

emmc_dev=2
sd_dev=1
boot_devices_mmcblk1=soc@0/30800000.bus/30b50000.mmc
boot_devices_mmcblk2=soc@0/30800000.bus/30b60000.mmc

mmc_seed_part=4
mmc_boot_part=5
devtype=mmc
boot_uc=run load_uc;bootm ${fitloadaddr}#${fdtfile}
fitloadaddr=0x45000000
console=ttymxc1,115200
splashimage=0x50000000
fdtfile=CONFIG_DEFAULT_FDT_FILE
ip_dyn=yes
mmcautodetect=yes
mmcdev=CONFIG_ENV_MMC_DEVICE_INDEX
prepare_mcore=setenv mcore_clk clk-imx8mm.mcore_booted;

nodes=/usbg1 /usbg2 /wdt-reboot /dsi-host /rm67199_panel /soc@0/bus@32c00000/lcdif@32e00000 /soc@0/bus@32c00000/csi@32e20000 /soc@0/bus@32c00000/mipi_dsi@32e10000 /soc@0/bus@32c00000/mipi_csi@32e30000 /audio-codec-bt-sco /sound-bt-sco /audio-codec /sound-wm8524 /soc@0/bus@30800000/i2c@30a20000/pca9450@25 /soc@0/bus@30800000/i2c@30a30000/adv7535@3d /soc@0/memory-controller@3d400000 /binman /soc@0/video-codec@38300000 /soc@0/video-codec@38310000 /soc@0/gpu@38000000 /soc@0/gpu@38008000 /soc@0/pcie-ep@33800000 /soc@0/bus@30800000/crypto@30900000
sr_ir_v2_cmd=setenv opteeoverlay no;cp.b ${fdtcontroladdr} ${fdt_addr_r} 0x10000;
	fdt addr ${fdt_addr_r};
	for i in ${nodes}; do fdt rm ${i}; done

mmcargs=setenv bootargs ${jh_clk} ${mcore_clk} console=${console} root=${mmcroot}
prepare_mcore=setenv mcore_clk clk-imx8mn.mcore_booted
