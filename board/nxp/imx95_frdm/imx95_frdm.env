#include <env/nxp/imx_env.env>

#ifdef CONFIG_ANDROID_SUPPORT
splashpos=m,m
splashimage=0x9FFF0000
fdt_high=0xffffffffffffffff
initrd_high=0xffffffffffffffff
emmc_dev=0
sd_dev=1
boot_devices_mmcblk0=soc/42800000.bus/42850000.mmc
boot_devices_mmcblk1=soc/42800000.bus/42860000.mmc
#else

#ifdef CONFIG_AHAB_BOOT
sec_boot=yes
#else
sec_boot=no
#endif

emmc_dev=0
sd_dev=1

mmc_system_part_a=5
mmc_system_part_b=6
mmc_apps_part_a=7
mmc_apps_part_b=8
devtype=mmc
boot_uc=run load_uc_mini;bootm ${fitloadaddr}#${fdtfile}

sr_ir_v2_cmd=cp.b ${fdtcontroladdr} ${fdt_addr_r} 0x20000; fdt addr ${fdt_addr_r};
	fdt set /soc/bus@44000000/mailbox@445b0000/sram@445b1000/scmi-sram-section@0 reg <0x00000000 0x00000080>;
	fdt rm /soc/mailbox@47530000;
	fdt rm /soc/usb@4c010010;

fitloadaddr=0x98000000
splashimage=0xA0000000
cntr_addr=0xA8000000
cntr_file=os_cntr_signed.bin
console=ttyLP0,115200 earlycon
fdtfile=CONFIG_DEFAULT_FDT_FILE
mmcdev=CONFIG_ENV_MMC_DEVICE_INDEX
mmcautodetect=yes
mmcargs=setenv bootargs ${jh_clk} ${mcore_args} console=${console} root=${mmcroot}
prepare_mcore=setenv mcore_args pd_ignore_unused;

#endif
